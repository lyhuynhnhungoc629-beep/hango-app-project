# Cấu hình Firebase cho HANGO
# Lấy các thông số này từ Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cấu hình SQL Server quản lý Dataset chữ viết tay tiếng Hàn
SQL_SERVER_INSTANCE=.\SQLEXPRESS
SQL_SERVER_DATABASE=HangoDatasetDB

# Cấu hình Bảo mật Tài khoản Admin gốc duy nhất (Root Admin)
ROOT_ADMIN_UID=hango_root_admin_001
ROOT_ADMIN_EMAIL=admin@gmail.com
ROOT_ADMIN_DEFAULT_PASSWORD=123456
ROOT_ADMIN_RECOVERY_KEY=HANGO-ROOT-RECOVERY-2026-KEY
